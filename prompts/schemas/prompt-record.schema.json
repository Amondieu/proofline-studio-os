{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofline:prompt-record:v1",
  "title": "Proofline Prompt Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "tool", "purpose", "inputs_allowed", "outputs_expected", "hard_exclusions", "quality_rubric", "owner", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "tool": { "enum": ["higgsfield", "llmarena", "repository"] },
    "purpose": { "type": "string", "minLength": 10 },
    "inputs_allowed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outputs_expected": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "hard_exclusions": { "type": "array", "items": { "type": "string" } },
    "quality_rubric": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner": { "type": "string", "minLength": 2 },
    "status": { "enum": ["draft", "pilot", "approved", "retired"] }
  }
}
