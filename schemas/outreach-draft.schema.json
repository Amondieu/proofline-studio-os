{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofline:studio:outreach-draft:v1",
  "title": "Proofline Outreach Draft v1",
  "description": "A personalized message draft that cannot authorize its own send.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "prospect_id", "sequence_step", "recipient_role", "recipient_email", "subject", "body", "evidence_urls", "includes_opt_out", "status", "human_review_required"],
  "properties": {
    "schema_version": { "const": "studio.outreach-draft.v1" },
    "draft_id": { "type": "string", "pattern": "^draft_[a-z0-9_-]{4,80}$" },
    "prospect_id": { "type": "string", "pattern": "^pr_[0-9]{4}_[0-9]{4,}$" },
    "sequence_step": { "enum": [1, 2, 3] },
    "recipient_role": { "type": "string", "minLength": 2 },
    "recipient_email": { "type": "string", "minLength": 5 },
    "subject": { "type": "string", "minLength": 3 },
    "body": { "type": "string", "minLength": 20 },
    "evidence_urls": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 8 } },
    "includes_opt_out": { "const": true },
    "status": { "enum": ["draft_only", "pending_human_approval", "approved", "sent", "blocked"] },
    "human_review_required": { "const": true }
  }
}
