{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofline:pattern-record:v1",
  "title": "Proofline Pattern Record v1",
  "description": "A research-backed pattern card. A pattern is not an approved default until a human review promotes it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pattern_id", "name", "category", "status", "problem_solves", "use_only_when", "do_not_use_when", "target_client_fit", "user_conversion_hypothesis", "evidence_level", "evidence", "implementation", "accessibility_requirements", "performance_budget", "trust_legal_requirements", "low_cost_version", "premium_version", "test_method", "success_signal", "failure_signal", "next_controlled_test", "scores", "readiness_score", "cookbook_tags"],
  "properties": {
    "schema_version": { "const": "studio.pattern-record.v1" },
    "pattern_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,8}-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 3 },
    "category": { "type": "string", "minLength": 3 },
    "status": { "enum": ["approved", "pilot", "reference_only", "avoid"] },
    "problem_solves": { "type": "string", "minLength": 10 },
    "use_only_when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "do_not_use_when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "target_client_fit": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "user_conversion_hypothesis": { "type": "string", "minLength": 10 },
    "evidence_level": { "enum": ["authoritative", "strong_practitioner", "observational", "inference"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "url", "level", "note"],
        "properties": {
          "source_id": { "type": "string", "minLength": 2 },
          "title": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "minLength": 8 },
          "level": { "enum": ["authoritative", "strong_practitioner", "observational", "inference"] },
          "note": { "type": "string", "minLength": 10 }
        }
      }
    },
    "implementation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "accessibility_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "performance_budget": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "trust_legal_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "low_cost_version": { "type": "string", "minLength": 10 },
    "premium_version": { "type": "string", "minLength": 10 },
    "test_method": { "type": "string", "minLength": 10 },
    "success_signal": { "type": "string", "minLength": 5 },
    "failure_signal": { "type": "string", "minLength": 5 },
    "next_controlled_test": { "type": "string", "minLength": 5 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clarity_impact", "conversion_plausibility", "trust_impact", "mobile_suitability", "accessibility_safety", "performance_safety", "implementation_cost", "maintenance_burden", "legal_safety", "studio_fit"],
      "properties": {
        "clarity_impact": { "type": "number", "minimum": 0, "maximum": 10 },
        "conversion_plausibility": { "type": "number", "minimum": 0, "maximum": 10 },
        "trust_impact": { "type": "number", "minimum": 0, "maximum": 10 },
        "mobile_suitability": { "type": "number", "minimum": 0, "maximum": 10 },
        "accessibility_safety": { "type": "number", "minimum": 0, "maximum": 10 },
        "performance_safety": { "type": "number", "minimum": 0, "maximum": 10 },
        "implementation_cost": { "type": "number", "minimum": 0, "maximum": 10 },
        "maintenance_burden": { "type": "number", "minimum": 0, "maximum": 10 },
        "legal_safety": { "type": "number", "minimum": 0, "maximum": 10 },
        "studio_fit": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "readiness_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "cookbook_tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "reviewed_by": { "type": ["string", "null"] },
    "reviewed_on": { "type": ["string", "null"], "format": "date" }
  }
}
