{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofline:studio:harness-report:v1",
  "title": "Proofline Studio Harness Report v1",
  "description": "A read-only readiness report. It cannot approve or launch a project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "readOnly", "authoritative", "launchAuthority", "gates", "blockedGates", "readyForHumanLaunchReview", "readyToLaunch", "limitations"],
  "properties": {
    "schemaVersion": { "const": "studio.harness-report.v1" },
    "projectId": { "type": "string" },
    "readOnly": { "const": true },
    "authoritative": { "const": false },
    "launchAuthority": { "const": false },
    "gates": { "type": "array", "minItems": 5 },
    "blockedGates": { "type": "array", "items": { "type": "string" } },
    "readyForHumanLaunchReview": { "type": "boolean" },
    "readyToLaunch": { "const": false },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
