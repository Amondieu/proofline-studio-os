{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofline:studio:higgsfield-asset-record:v1",
  "title": "Proofline Higgsfield Asset Record v1",
  "description": "Human-gated provenance and production decision for an abstract creative asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "project_id",
    "type",
    "purpose",
    "generator",
    "generated_at",
    "prompt_version",
    "input_classes",
    "reference_assets_used",
    "contains_realistic_human",
    "contains_third_party_brand",
    "rights_review_status",
    "disclosure_required",
    "approved_by",
    "approved_at",
    "production_usage"
  ],
  "properties": {
    "schema_version": { "const": "studio.higgsfield-asset-record.v1" },
    "asset_id": { "type": "string", "pattern": "^AST-HF-[0-9]{4,}$" },
    "project_id": { "type": "string", "pattern": "^studio_[a-z0-9_-]{4,80}$" },
    "type": { "enum": ["hero_image", "moodboard", "motion_loop", "social_visual", "other"] },
    "purpose": { "type": "string", "minLength": 10 },
    "generator": { "const": "Higgsfield" },
    "generated_at": { "type": "string", "format": "date-time" },
    "prompt_version": { "type": "string", "pattern": "^hf-[a-z0-9-]+-v[0-9]+\\.[0-9]+$" },
    "input_classes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["text_prompt_only", "own_asset", "client_asset", "personal_data", "third_party_brand"] }
    },
    "reference_assets_used": { "type": "array", "items": { "type": "string" } },
    "contains_realistic_human": { "const": false },
    "contains_third_party_brand": { "const": false },
    "rights_review_status": { "enum": ["pending_human_review", "approved", "rejected"] },
    "disclosure_required": { "type": "boolean" },
    "approved_by": { "type": ["string", "null"] },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "production_usage": { "enum": ["not_approved", "concept_only", "approved", "rejected"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "production_usage": { "const": "approved" }
        }
      },
      "then": {
        "properties": {
          "rights_review_status": { "const": "approved" },
          "approved_by": { "type": "string", "minLength": 2 },
          "approved_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ]
}
