{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofline:experiment-record:v1",
  "title": "Proofline Pattern Experiment Record v1",
  "description": "A controlled, low-traffic test that can promote, revise, or retire a cookbook entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "subject_id", "hypothesis", "context", "method", "audience", "success_signal", "failure_signal", "status", "evidence"],
  "properties": {
    "schema_version": { "const": "studio.experiment-record.v1" },
    "experiment_id": { "type": "string", "pattern": "^EXP-[0-9]{4,}$" },
    "subject_id": { "type": "string", "minLength": 3 },
    "hypothesis": { "type": "string", "minLength": 10 },
    "context": { "type": "string", "minLength": 10 },
    "method": { "type": "string", "minLength": 10 },
    "audience": { "type": "string", "minLength": 3 },
    "success_signal": { "type": "string", "minLength": 5 },
    "failure_signal": { "type": "string", "minLength": 5 },
    "result": { "type": ["string", "null"] },
    "status": { "enum": ["planned", "running", "complete", "inconclusive", "stopped"] },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "human_decision": { "type": ["string", "null"] },
    "completed_on": { "type": ["string", "null"], "format": "date" }
  }
}
