{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofline:studio:signal-record:v1",
  "title": "Proofline Signal Record v1",
  "description": "A dated public signal that supports, but never proves, prospect fit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "signal_type", "evidence_url", "observed_on", "confidence", "observation"],
  "properties": {
    "schema_version": { "const": "studio.signal-record.v1" },
    "signal_id": { "type": "string", "pattern": "^sig_[a-z0-9_-]{4,80}$" },
    "signal_type": { "type": "string", "minLength": 3 },
    "evidence_url": { "type": "string", "minLength": 8 },
    "observed_on": { "type": "string", "format": "date" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "observation": { "type": "string", "minLength": 10 }
  }
}
